{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "tanstack-start",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "src/routes/api.ai.stream.ts": {
      "maxDuration": 300
    },
    "src/lib/agent.functions.ts": {
      "maxDuration": 300
    }
  }
}
